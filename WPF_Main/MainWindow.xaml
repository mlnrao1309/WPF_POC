<Window x:Class="AlgoTrading.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlgoTrading"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:AlgoTrading.ViewModels"
        xmlns:behaviors="clr-namespace:AlgoTrading.Behaviors"
        mc:Ignorable="d" Title="AlgoTrading · Market Data" Height="450" Width="800" WindowState="Maximized">

    <!-- DataContext is provided by DI (App.xaml.cs) -->
    <Window.Resources>
        <behaviors:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="500" Text="{Binding Uri, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding NavigateCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Go" Command="{Binding NavigateCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       Margin="0,4,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
        </StackPanel>

        <!-- WebView2 control from Microsoft.Web.WebView2 -->
        <wv2:WebView2 x:Name="WebView2Control" Grid.Row="1"
                     behaviors:WebView2Behavior.Source="{Binding NavigationSource}"
                     behaviors:WebView2Behavior.ResponseReceivedCommand="{Binding WebResourceResponseReceivedCommand}"
                     behaviors:WebView2Behavior.WebSocketFrameReceivedCommand="{Binding WebSocketFrameReceivedCommand}" 
                     behaviors:WebView2Behavior.TargetCookieName="enctoken"
                     behaviors:WebView2Behavior.TokenReceivedCommand="{Binding ProcessAccessTokenCommand}"
                      />

        <!-- Status bar with selectable messages and clear buttons -->
        <StatusBar VerticalAlignment="Bottom" Grid.Row="2" Margin="0,8,0,0">
            <DockPanel LastChildFill="True">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" >
                        <Button Content="Clear Selected" Command="{Binding ClearSelectedCommand}" Margin="4,0" />
                        <Button Content="Clear All" Command="{Binding ClearAllCommand}" Margin="4,0" />
                        <Button Content="Read Cur. MarketWatch" Command="{Binding ReadCurrentMarketWatchCommand}" Margin="4,0" />
                        <Button Content="Market Watch" Command="{Binding OpenMarketWatchCommand}" Margin="4,0" />
                        <Button Content="Screener" Command="{Binding OpenScreenerCommand}" Margin="4,0" />
                        <Button Content="Fetch Hist. Data" Command="{Binding FetchHistoricalDataCommand}" Margin="4,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding StatusMessages}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionMode="Extended"
                         BorderThickness="0"
                         behaviors:ListBoxSelectedItemsBehavior.SelectedItems="{Binding SelectedStatusMessages}" Grid.Row="1">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatusMessage}">
                                <Button Command="{Binding DataContext.ShowMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Margin="4,0,4,0"
                                    ToolTip="Click to view details">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='[{0:T}] '}" FontSize="11" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </StatusBar>
    </Grid>
</Window>
