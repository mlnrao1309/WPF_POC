<Window x:Class="AlgoTrading.Screener.Wpf.SaveQueryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Query"
        Width="420" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Name this query:"
               Margin="0,0,0,6"/>

    <TextBox Grid.Row="1"
             x:Name="NameBox"
             Height="26"
             Padding="4,2"
             VerticalContentAlignment="Center"/>

    <TextBlock Grid.Row="2"
               Text="Names must be unique. Saving with an existing name creates a separate entry."
               FontSize="11"
               Foreground="Gray"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               VerticalAlignment="Top"/>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="Save"
              Width="80" Height="26"
              IsDefault="True"
              Click="Save_Click"/>
      <Button Content="Cancel"
              Width="80" Height="26"
              Margin="8,0,0,0"
              IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>