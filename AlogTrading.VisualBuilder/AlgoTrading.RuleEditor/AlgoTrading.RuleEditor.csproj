<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
<UseWPF>true</UseWPF>
    <DisableWpfTempProject>true</DisableWpfTempProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AlgoTrading.RuleEditor</RootNamespace>
    <AssemblyName>AlgoTrading.RuleEditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AlgoTrading.RuleEditor.csproj.bak" />
    <None Remove="app.manifest" />
    <None Remove="README.md" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Replay\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Library\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Release'">Always</CopyToOutputDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AlgoTrading.Models\AlgoTrading.Models.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>D:\MyWorkspace\TradingRuleEditor_DeepSeek\Project\Library\bin\</OutputPath>
  </PropertyGroup>


  <!-- Delta 01.5: Release output to ..\Library\bin\<TFM>\ -->
  <PropertyGroup Condition="'`$(Configuration)'=='Release'">
    <OutDir>..\Library\bin\`$(TargetFramework)\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
