<UserControl x:Class="AlgoTrading.RuleEditor.Tabs.ConditionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AlgoTrading.RuleEditor.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="GroupHost" Margin="10"/>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ExtraScroll">
            <controls:StopLossTargetPanel x:Name="SlTpPanel" Margin="10,0,10,10" Visibility="Collapsed"/>
        </ScrollViewer>
    </Grid>
</UserControl>