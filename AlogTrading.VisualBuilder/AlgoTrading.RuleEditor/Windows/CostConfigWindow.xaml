<Window x:Class="AlgoTrading.RuleEditor.Windows.CostConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cost Configuration" Height="560" Width="780"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <TabControl DockPanel.Dock="Top" Margin="10">
            <TabItem Header="Equity" IsSelected="True">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Delivery" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="DeliveryGrid"/>
                        </ScrollViewer>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="Intraday" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="IntradayGrid"/>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Options (v2)" IsEnabled="False"/>
            <TabItem Header="Futures (v2)" IsEnabled="False"/>
        </TabControl>

        <TextBlock DockPanel.Dock="Bottom" x:Name="PathLabel" Margin="12,0,12,6"
                   Foreground="DimGray" FontSize="11"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="12,6">
            <Button Content="Save" Width="100" Margin="0,0,8,0" Click="OnSaveClick"/>
            <Button Content="Cancel" Width="100" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </DockPanel>
</Window>