<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AlgoTrading.Backtest.Cli</RootNamespace>
    <AssemblyName>AlgoTrading.Backtest.Cli</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- Release output to the shared Library folder. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutDir>$(MSBuildThisFileDirectory)..\Library\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>D:\MyWorkspace\TradingRuleEditor_DeepSeek\Project\Library\bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AlgoTrading.Backtest.Cli.csproj.bak" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AlgoTrading.Aggregation\AlgoTrading.Aggregation.csproj" />
    <ProjectReference Include="..\AlgoTrading.Backtest\AlgoTrading.Backtest.csproj" />
    <ProjectReference Include="..\AlgoTrading.Models\AlgoTrading.Models.csproj" />
    <ProjectReference Include="..\AlgoTrading.Data\AlgoTrading.Data.csproj" />
  </ItemGroup>
	<ItemGroup>
		<None Include="..\Library\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Release'">PreserveNewest</CopyToOutputDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
	</ItemGroup>
</Project>
