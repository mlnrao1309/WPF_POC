<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AlgoTrading.Backtest.Cli</RootNamespace>
    <AssemblyName>AlgoTrading.Backtest.Cli</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- Delta 01.5: Release output to ..\Library\bin\<TFM>\ -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutDir>..\Library\bin\$(TargetFramework)\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>D:\MyWorkspace\TradingRuleEditor_DeepSeek\Project\Library\bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AlgoTrading.Backtest\AlgoTrading.Backtest.csproj" />
    <ProjectReference Include="..\AlgoTrading.Models\AlgoTrading.Models.csproj" />
    <ProjectReference Include="..\AlgoTrading.Data\AlgoTrading.Data.csproj" />
  </ItemGroup>
	<ItemGroup>
		<None Include="..\Library\appsettings.json"
			  Link="appsettings.json"
			  CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>