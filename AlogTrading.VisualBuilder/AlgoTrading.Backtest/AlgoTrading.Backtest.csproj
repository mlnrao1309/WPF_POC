<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AlgoTrading.Backtest</RootNamespace>
    <AssemblyName>AlgoTrading.Backtest</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release output to the shared Library folder. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutDir>$(MSBuildThisFileDirectory)..\Library\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlgoTrading.Models\AlgoTrading.Models.csproj" />
    <ProjectReference Include="..\AlgoTrading.Data\AlgoTrading.Data.csproj" />
    <ProjectReference Include="..\AlgoTrading.Aggregation\AlgoTrading.Aggregation.csproj" />
    <ProjectReference Include="..\..\Stage1Scanner.Core\Stage1Scanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlgoTrading.Backtest.Tests" />
  </ItemGroup>
</Project>
